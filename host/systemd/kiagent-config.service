[Unit]
Description=Kiagent bounded configuration broker
After=docker.service kiagent-executor.service kiagent-packages.service
Wants=docker.service
[Service]
User=root
Group=root
ExecStart=/usr/bin/python3 -I -B /usr/local/lib/kiagent-config/config_broker.py
LoadCredential=web-session-key:/etc/kiagent-docker/secrets/web-session-key
RuntimeDirectory=kiagent-config
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=kiagent-config
StateDirectoryMode=0700
UMask=0077
Environment=DOCKER_CONFIG=/run/kiagent-config/docker
Restart=on-failure
RestartSec=10
TimeoutStopSec=300
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_SETUID CAP_SETGID
ProtectSystem=strict
ReadWritePaths=/etc/kiagent-docker /var/backups/kiagent-config /var/lib/kiagent-config
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
