[Unit]
Description=Kiagent restricted host executor
After=kiagent-practice.service
[Service]
Type=simple
User=root
Group=kiagent
ExecStart=/usr/bin/python3 -I -B /opt/kiagent/executor/server.py
LoadCredential=allowed-users:/etc/kiagent-docker/secrets/allowed-users
LoadCredential=discord-access:/etc/kiagent-docker/secrets/discord-access.json
EnvironmentFile=/etc/kiagent-docker/deployment.env
RuntimeDirectory=kiagent-executor
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=kiagent-executor
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=/etc/kiagent-docker
MemoryMax=96M
TasksMax=16
[Install]
WantedBy=multi-user.target
