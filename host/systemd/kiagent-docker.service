[Unit]
Description=Kiagent Telegram and Discord containers
Requires=docker.service
After=docker.service kiagent-executor.service kiagent-packages.service kiagent-config.service network-online.target
Wants=network-online.target kiagent-config.service kiagent-executor.service kiagent-packages.service
[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/kiagent-docker/project
ExecStart=/usr/bin/docker compose --env-file /etc/kiagent-docker/deployment.env up -d --wait --wait-timeout 180
ExecStop=/usr/bin/docker compose --env-file /etc/kiagent-docker/deployment.env stop
TimeoutStartSec=240
TimeoutStopSec=90
[Install]
WantedBy=multi-user.target
