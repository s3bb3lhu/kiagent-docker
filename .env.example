DISCORD_UID=
KIAGENT_GID=
DISCORD_APPLICATION_ID=
KIAGENT_SECRETS_DIR=/etc/kiagent-docker/secrets
KIAGENT_RAID_DEVICES=md1,md2,md3,md4
CONFIG_UID=
CONFIG_GID=
CONFIG_ORIGIN=http://127.0.0.1:8787
